<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <UnityTestProfile Condition="'$(UnityTestProfile)' == ''">Editor</UnityTestProfile>
    <DefineConstants>$(DefineConstants);UNITY_5_3_OR_NEWER</DefineConstants>
    <!-- Serialized Inspector fields may be unused in a particular conditional compilation branch. -->
    <NoWarn>$(NoWarn);CS0414</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UnityTestProfile)' == 'Editor'">
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_STANDALONE;UNITY_STANDALONE_WIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UnityTestProfile)' == 'WindowsIL2CPP'">
    <DefineConstants>$(DefineConstants);UNITY_STANDALONE;UNITY_STANDALONE_WIN;ENABLE_IL2CPP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UnityTestProfile)' == 'Android'">
    <DefineConstants>$(DefineConstants);UNITY_ANDROID;ENABLE_IL2CPP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UnityTestProfile)' == 'WebGL'">
    <DefineConstants>$(DefineConstants);UNITY_WEBGL;ENABLE_IL2CPP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <Compile Include="../../Packages/jp.hotamachi.lumis.security/Runtime/**/*.cs" />
    <Compile Include="../../Packages/jp.hotamachi.lumis.security/Samples~/Bootstrap/*.cs" />
  </ItemGroup>
</Project>
