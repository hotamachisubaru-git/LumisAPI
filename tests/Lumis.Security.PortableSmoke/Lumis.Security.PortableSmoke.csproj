<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Build the netstandard2.1 assembly first. A direct reference deliberately tests that asset, not net8.0. -->
  <ItemGroup>
    <Reference Include="Lumis.Security">
      <HintPath>../../src/Lumis.Security/bin/$(Configuration)/netstandard2.1/Lumis.Security.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
